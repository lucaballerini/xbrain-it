---
/**
 * Decorative hero graphic — cloud as outer container + network inside.
 * Inline SVG, no HTTP, no filters; pulse desktop-only.
 */
---

<svg
  class="hero-visual"
  viewBox="0 0 420 360"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="cloudFill" x1="40" y1="60" x2="380" y2="300" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#0088ca" stop-opacity="0.26" />
      <stop offset="100%" stop-color="#006291" stop-opacity="0.1" />
    </linearGradient>
    <clipPath id="cloudClip">
      <path
        d="M78 228
           c-28 0-50-22-50-50
           c0-24 16-44 38-49
           c4-36 34-64 72-64
           c22 0 42 8 56 22
           c16-28 46-46 80-46
           c52 0 94 40 96 91
           c28 4 50 28 50 56
           c0 32-26 58-58 58
           H108
           c-16 0-30-14-30-30
           c0-4 1-8 2-12
           c-1 0-2 0-2 0Z"
      />
    </clipPath>
  </defs>

  <!-- Cloud container -->
  <path
    fill="url(#cloudFill)"
    stroke="#0088ca"
    stroke-width="1.75"
    stroke-opacity="0.4"
    d="M78 228
       c-28 0-50-22-50-50
       c0-24 16-44 38-49
       c4-36 34-64 72-64
       c22 0 42 8 56 22
       c16-28 46-46 80-46
       c52 0 94 40 96 91
       c28 4 50 28 50 56
       c0 32-26 58-58 58
       H108
       c-16 0-30-14-30-30
       c0-4 1-8 2-12
       c-1 0-2 0-2 0Z"
  />

  <!-- Soft inner highlight -->
  <path
    fill="#ffffff"
    fill-opacity="0.18"
    d="M120 150
       c8-28 36-48 68-48
       c18 0 34 6 46 18
       c12-18 32-30 56-30
       c34 0 62 24 66 56
       c-22-8-48-6-70 8
       c-18-16-44-22-70-16
       c-24 6-42 22-52 44
       c-14-10-30-16-44-16
       c-4 0-8 0-12 1
       c2-6 6-12 12-17Z"
  />

  <!-- Network clipped inside cloud -->
  <g clip-path="url(#cloudClip)">
    <g fill="none" stroke="#0088ca" stroke-width="1.5" stroke-opacity="0.4">
      <path d="M110 180 L168 148 L236 168 L300 132" />
      <path d="M168 148 L186 208 L236 168" />
      <path d="M186 208 L248 246 L304 210" />
      <path d="M236 168 L304 210 L340 170" />
      <path d="M110 180 L140 236 L186 208" />
      <path d="M168 148 L210 118 L268 140" />
    </g>

    <g fill="#0088ca">
      <circle class="hero-node" cx="110" cy="180" r="6.5" fill-opacity="0.8" />
      <circle class="hero-node hero-node-2" cx="168" cy="148" r="8.5" fill-opacity="0.95" />
      <circle class="hero-node" cx="210" cy="118" r="6" fill-opacity="0.75" />
      <circle class="hero-node hero-node-3" cx="236" cy="168" r="8" fill-opacity="0.9" />
      <circle class="hero-node" cx="268" cy="140" r="6" fill-opacity="0.78" />
      <circle class="hero-node hero-node-2" cx="186" cy="208" r="9.5" />
      <circle class="hero-node" cx="140" cy="236" r="5.5" fill-opacity="0.72" />
      <circle class="hero-node" cx="248" cy="246" r="6.5" fill-opacity="0.8" />
      <circle class="hero-node hero-node-3" cx="304" cy="210" r="7.5" fill-opacity="0.88" />
      <circle class="hero-node" cx="300" cy="132" r="5.5" fill-opacity="0.7" />
      <circle class="hero-node" cx="340" cy="170" r="5.5" fill-opacity="0.7" />
    </g>
  </g>
</svg>
