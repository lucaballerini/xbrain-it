---
/**
 * Decorative hero graphic — stylized brain + neural links.
 * Inline SVG (~2–3KB), no HTTP, no filters; pulse desktop-only.
 */
---

<svg
  class="hero-visual"
  viewBox="0 0 420 360"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="brainFill" x1="70" y1="40" x2="360" y2="320" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#0088ca" stop-opacity="0.22" />
      <stop offset="100%" stop-color="#006291" stop-opacity="0.1" />
    </linearGradient>
  </defs>

  <!-- Left hemisphere -->
  <path
    fill="url(#brainFill)"
    stroke="#0088ca"
    stroke-opacity="0.35"
    stroke-width="1.5"
    d="M206 58c-28-8-58-2-82 18-28 24-42 62-38 102 3 28 16 52 36 68 14 12 18 28 10 42-6 10 2 18 14 14 18-6 34-4 48 8 8 6 18 4 22-4V66c-2-6-6-8-10-8Z"
  />

  <!-- Right hemisphere -->
  <path
    fill="url(#brainFill)"
    stroke="#0088ca"
    stroke-opacity="0.35"
    stroke-width="1.5"
    d="M214 58c28-8 58-2 82 18 28 24 42 62 38 102-3 28-16 52-36 68-14 12-18 28-10 42 6 10-2 18-14 14-18-6-34-4-48 8-8 6-18 4-22-4V66c2-6 6-8 10-8Z"
  />

  <!-- Midline -->
  <path
    d="M210 66 V292"
    fill="none"
    stroke="#006291"
    stroke-width="1.5"
    stroke-opacity="0.25"
    stroke-dasharray="3 5"
  />

  <!-- Gyri / folds (left) -->
  <g fill="none" stroke="#0088ca" stroke-width="1.4" stroke-opacity="0.4" stroke-linecap="round">
    <path d="M126 98c22-18 48-20 68-8" />
    <path d="M112 138c26-14 54-12 74 4" />
    <path d="M118 178c24-10 50-6 68 12" />
    <path d="M132 218c20-8 42-4 58 10" />
    <path d="M148 252c16-6 34 0 46 12" />
  </g>

  <!-- Gyri / folds (right) -->
  <g fill="none" stroke="#0088ca" stroke-width="1.4" stroke-opacity="0.4" stroke-linecap="round">
    <path d="M294 98c-22-18-48-20-68-8" />
    <path d="M308 138c-26-14-54-12-74 4" />
    <path d="M302 178c-24-10-50-6-68 12" />
    <path d="M288 218c-20-8-42-4-58 10" />
    <path d="M272 252c-16-6-34 0-46 12" />
  </g>

  <!-- Neural links -->
  <g fill="none" stroke="#006291" stroke-width="1.25" stroke-opacity="0.32">
    <path d="M152 128 L188 156 L210 148" />
    <path d="M268 128 L232 156 L210 148" />
    <path d="M168 188 L210 176 L252 188" />
    <path d="M186 228 L210 206 L234 228" />
  </g>

  <!-- Synapse nodes -->
  <g fill="#0088ca">
    <circle class="hero-node" cx="152" cy="128" r="5" fill-opacity="0.8" />
    <circle class="hero-node hero-node-2" cx="188" cy="156" r="6.5" fill-opacity="0.95" />
    <circle class="hero-node" cx="268" cy="128" r="5" fill-opacity="0.8" />
    <circle class="hero-node hero-node-3" cx="232" cy="156" r="6.5" fill-opacity="0.95" />
    <circle class="hero-node hero-node-2" cx="210" cy="148" r="7.5" />
    <circle class="hero-node" cx="168" cy="188" r="5" fill-opacity="0.75" />
    <circle class="hero-node" cx="252" cy="188" r="5" fill-opacity="0.75" />
    <circle class="hero-node hero-node-3" cx="210" cy="176" r="6" fill-opacity="0.9" />
    <circle class="hero-node" cx="186" cy="228" r="4.5" fill-opacity="0.7" />
    <circle class="hero-node" cx="234" cy="228" r="4.5" fill-opacity="0.7" />
    <circle class="hero-node" cx="210" cy="206" r="5.5" fill-opacity="0.85" />
  </g>

  <!-- Soft outer ring (activity) -->
  <ellipse
    class="hero-ring"
    cx="210"
    cy="170"
    rx="128"
    ry="108"
    fill="none"
    stroke="#006291"
    stroke-width="1.25"
    stroke-opacity="0.16"
  />
</svg>
