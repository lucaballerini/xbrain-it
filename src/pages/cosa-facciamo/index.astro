---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
---

<BaseLayout
  title="Cosa facciamo"
  description="Servizi XBRAIN: siti web, ecommerce, app, SEO, Google Ads, social media marketing, hosting e consulenza IT a Civitanova Marche."
  path="/cosa-facciamo/"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Cosa facciamo</p>
      <h1>Siti web, ecommerce, marketing e IT</h1>
      <p class="lead">
        Un unico partner per progettare, sviluppare e promuovere la tua presenza digitale.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem">
    <div class="container" style="display:grid;gap:1.5rem">
      <article class="contact-card">
        <h2 style="font-size:1.35rem">
          <a href="/cosa-facciamo/siti-web-e-ecommerce/">Siti web, ecommerce e app</a>
        </h2>
        <ul class="list-check">
          <li>Realizzazione siti internet e ecommerce</li>
          <li>Creazione blog e piattaforme web</li>
          <li>Applicazioni Facebook e integrazioni API</li>
          <li>Web services e registrazione domini</li>
        </ul>
      </article>

      <article class="contact-card">
        <h2 style="font-size:1.35rem">
          <a href="/cosa-facciamo/web-marketing-e-social-media/">Web marketing e social media</a>
        </h2>
        <ul class="list-check">
          <li>Posizionamento e ottimizzazione SEO</li>
          <li>Campagne Google Ads e SEM / PPC</li>
          <li>Link building</li>
          <li>Strategie social su Meta, Instagram, LinkedIn e altri network</li>
        </ul>
      </article>

      <article class="contact-card">
        <h2 style="font-size:1.35rem">
          <a href="/cosa-facciamo/consulenza-e-assistenza-it/">IT e networking</a>
        </h2>
        <ul class="list-check">
          <li>Hosting, domini e posta elettronica</li>
          <li>Consulenza e assistenza hardware/software</li>
          <li>Networking e sistemistica Apple, Linux, Windows</li>
          <li>Sistemi LAMP in-house, housing o cloud</li>
        </ul>
      </article>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
