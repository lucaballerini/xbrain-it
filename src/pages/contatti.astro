---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contatti XBRAIN srl',
  url: `${site.url}/contatti/`,
};
---

<BaseLayout
  title="Contatti"
  description={`Contatta XBRAIN srl a Civitanova Marche per informazioni e preventivi. Scrivi a ${site.email} o compila il form.`}
  path="/contatti/"
  jsonLd={contactSchema}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contatti</p>
      <h1>Scrivici senza impegno</h1>
      <p class="lead">
        Per informazioni, un contatto commerciale, un preventivo o un incontro conoscitivo preferiamo l’email:
        compila il form oppure scrivi a <a href={`mailto:${site.email}`}>{site.email}</a> — ti rispondiamo in breve
        tempo.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem">
    <div class="container split-2">
      <form class="form" method="POST" action={`https://formsubmit.co/${site.email}`}>
        <input type="hidden" name="_subject" value="Richiesta contatto dal sito xbrain.it" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value={`${site.url}/contatti/?inviato=1`} />
        <input type="hidden" name="_replyto" value="" />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

        <label>
          Nome e cognome *
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>
          Email *
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label>
          Telefono
          <input type="tel" name="phone" autocomplete="tel" />
        </label>
        <label>
          Messaggio *
          <textarea name="message" rows="6" required></textarea>
        </label>
        <div class="form-consents">
          <label class="form-consent">
            <input type="checkbox" name="privacy_view" value="1" required />
            <span>
              Ho preso visione dell’
              <a href="/informativa-privacy/">informativa sul trattamento dei dati personali</a>.
            </span>
          </label>
          <label class="form-consent">
            <input type="checkbox" name="privacy_consent" value="1" required />
            <span>
              Presto il consenso al trattamento dei miei dati personali per essere ricontattato via email in merito
              alla richiesta.
            </span>
          </label>
        </div>
        <button class="btn btn-primary" type="submit">Invia email</button>
        {
          Astro.url.searchParams.get('inviato') === '1' && (
            <p role="status" style="color:var(--xb-blue);font-weight:700;margin:0">
              Grazie: la tua richiesta è stata inviata.
            </p>
          )
        }
      </form>

      <aside class="contact-card">
        <h2 style="font-size:1.25rem">XBRAIN srl</h2>
        <p>
          {site.address.street}<br />
          {site.address.city} — {site.address.region}
        </p>
        <p>
          <strong>Email (preferito)</strong><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p>
          <strong>Telefono</strong><br />
          <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a><br />
          <a href={`tel:${site.mobile}`}>{site.mobileDisplay}</a>
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>
