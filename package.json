{
  "name": "xbrain-it",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Sito ufficiale XBRAIN srl — Astro, Core Web Vitals first",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
